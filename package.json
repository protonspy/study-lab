{
  "name": "study-lab",
  "productName": "Study Lab",
  "private": true,
  "version": "0.1.5",
  "description": "Desktop study workspace with spaced repetition, learning analytics and an AI study coach.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "pin-claude-code": "node scripts/pin-claude-code.mjs"
  },
