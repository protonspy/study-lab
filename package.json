    "@fontsource/ibm-plex-sans": "5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/langgraph-sdk": "^1.12.7",
    "@langchain/mcp-adapters": "^2.0.1",
    "@langchain/openai": "^1.7.0",
    "@langchain/openrouter": "^0.4.19",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-fcose": "^2.2.0",
    "deepagents": "^1.15.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "langchain": "^1.5.19",
    "langsmith": "^0.11.1",
    "lucide-react": "1.52.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
