{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/protonspy/study-lab/schemas/content-package.schema.json",
  "title": "Study Lab Content Package v1",
  "description": "Course material any importer or exporter can produce for Study Lab: documents to read and assessments to practise. A file may hold one package or an array of packages.",
  "type": "object",
  "required": ["format", "version", "source", "documents", "assessments"],
  "properties": {
    "format": { "const": "study-lab/content-package" },
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["adapter", "provider", "id", "title"],
      "properties": {
        "adapter": { "type": "string", "description": "Tool that produced the package, e.g. udemy-study-export, coursera-export." },
        "provider": { "type": "string", "description": "Platform or origin: udemy, coursera, local…" },
        "id": { "type": "string", "description": "Stable id of the course. Re-importing the same id updates the material and keeps the learner's progress." },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "language": { "type": "string", "description": "BCP 47 tag, e.g. en, pt-BR." },
        "exportedAt": { "type": "string", "format": "date-time" }
      }
    },
    "lab": {
      "type": "object",
      "description": "Optional setup hints, used only when the lab has not set them yet.",
      "properties": {
        "kind": { "enum": ["certification", "language", "course", "other"] },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["n", "name", "w"],
            "properties": { "n": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "short": { "type": "string" }, "w": { "type": "number", "description": "Exam weight in percent." } }
          }
        },
        "exam": {
          "type": ["object", "null"],
          "properties": {
            "code": { "type": "string" },
            "questions": { "type": "integer" },
            "scored": { "type": "integer" },
            "minutes": { "type": "integer" },
            "pass": { "type": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "kind", "text"],
        "properties": {
          "id": { "type": "string", "description": "Stable within the source." },
          "order": { "type": "integer", "minimum": 1, "description": "Position in the course. Course order is used as a weak prerequisite signal." },
          "title": { "type": "string" },
          "section": { "type": "string" },
          "kind": { "enum": ["lecture", "reading", "article", "chapter", "note", "transcript"] },
          "text": { "type": "string", "description": "Plain text or Markdown; paragraphs separated by blank lines." },
          "durationSec": { "type": "number" },
          "url": { "type": "string" }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "items"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "enum": ["quiz", "exam", "practice"] },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "n", "stem", "options", "answer"],
              "properties": {
                "id": { "type": "string" },
                "n": { "type": "integer" },
                "stem": { "type": "string" },
                "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
                "answer": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "description": "0-based indexes of the correct options." },
                "rationales": { "type": "array", "items": { "type": "string" }, "description": "One per option: why it is right or wrong." },
                "explanation": { "type": "string" },
                "domain": { "type": "integer" },
                "topics": { "type": "array", "items": { "type": "string" } },
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "description": "An already-built knowledge base (topics, flashcards, question tags) in Study Lab's internal shape. Question ids are kept as given.",
      "properties": {
        "topics": { "type": "array" },
        "cards": { "type": "array" },
        "tags": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "builtAt": { "type": "string" }
      }
    }
  }
}
